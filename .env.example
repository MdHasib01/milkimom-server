# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=https://milkimom.com
SITE_URL=https://milkimom.com

# MongoDB
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/milkimom?retryWrites=true&w=majority

# CORS - comma separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173,https://milkimom.xyz,https://milkimom.com,https://www.milkimom.com

# BD Bulk SMS API
BD_SMS_API_URL=https://api.bdbulksms.net/api.php
BD_SMS_TOKEN=YOUR_API_TOKEN

# Admin phone for order notifications
ADMIN_PHONE=01975917919

# Admin email for order notifications (fallback; configurable in the admin dashboard settings)
ADMIN_EMAIL=milkimominfo@gmail.com

# JWT secret for admin authentication (use a long random string in production)
JWT_SECRET=change-me-to-a-long-random-secret

# SMTP for sending admin order notification emails (e.g. Gmail app password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=Milkimom <your@gmail.com>

# Meta Conversions API — Purchase is sent server-side only when an order is
# marked Delivered. Generate the token in Events Manager → your pixel →
# Settings → Conversions API → Generate access token.
META_PIXEL_ID=1067546575776185
META_CAPI_ACCESS_TOKEN=your-conversions-api-access-token
# Optional: while set, events appear in Events Manager → Test events instead of live
# META_TEST_EVENT_CODE=TEST12345

# Steadfast Courier — normally configured from the admin dashboard
# (Settings → Steadfast Courier tab); these env variables are only a fallback.
# Get the keys from https://steadfast.com.bd → API.
# STEADFAST_API_KEY=your-steadfast-api-key
# STEADFAST_SECRET_KEY=your-steadfast-secret-key
# STEADFAST_BASE_URL=https://portal.packzy.com/api/v1

# First admin user seed (npm run seed)
SEED_ADMIN_NAME=Admin
SEED_ADMIN_EMAIL=admin@milkimom.com
SEED_ADMIN_PASSWORD=milkimom123
